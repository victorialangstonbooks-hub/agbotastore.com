# ---- Agbota Segun — environment variables ----
# Copy to .env for local development. On Render set these in the dashboard.

PORT=10000
NODE_ENV=production

# Persistent PostgreSQL connection string (Render Postgres -> Internal Database URL)
DATABASE_URL=postgres://user:password@host:5432/dbname

# Long random string. Generate with: openssl rand -hex 48
JWT_SECRET=change-me-to-a-long-random-string

# Owner / admin account (seeded automatically on boot)
ADMIN_EMAIL=agbotasegun.outreach@gmail.com
ADMIN_PASSWORD=change-me-strong-password
ADMIN_NAME=Agbota Segun

# Payment configuration (shown in the payment UI)
BTC_ADDRESS=
PAYPAL_INSTRUCTIONS=Pay through PayPal Friends and Family. PayPal email: Ajayiawwl100@gmail.com

# Uploads
MAX_UPLOAD_MB=10
